# Publish source code and setup documentation only; keep local research assets private.
/*
!/.gitignore
!/.env.example
!/AGENTS.md
!/README.md
!/requirements.txt
!/UROP.py
!/src/
!/experiments/
!/scripts/
!/tests/
!/docs/

# Credentials and machine-specific configuration, including nested files.
.env
.env.*
!.env.example
*.pem
*.key
credentials.json
secrets.json
.aws/
.codex/
.agents/

# Environments, caches, test output, and editor files.
.venv/
venv/
__pycache__/
*.py[cod]
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/
.idea/
.vscode/
.DS_Store
*.swp
*.tmp

# Datasets, models, results, and unpublished manuscripts.
data/
paper/
*.joblib
*.pkl
*.pickle
*.npz
*.npy
*.pt
*.pth
*.safetensors
*.gguf
*.faiss
*.jsonl
*.parquet
*.csv
*.log
*.hwp
*.hwpx
*.pdf
*.zip
*.tar
*.gz
