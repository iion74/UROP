# Publish source code and setup documentation only; keep local research assets private.
/*
!/.gitignore
!/.gitattributes
!/.env.example
!/AGENTS.md
!/README.md
!/requirements.txt
!/UROP.py
!/src/
!/experiments/
!/scripts/
!/tests/
!/docs/
!/paper/
!/requirements-research.txt
!/requirements-research-snapshot.txt
!/*.md
!/data/

# Keep data closed by default; allow only reviewed research reports and final policies.
/data/*
!/data/benchmarks/
!/data/models/
/data/benchmarks/*
!/data/benchmarks/multihop/
/data/models/*
!/data/models/sequential_answer_gain_multiseed/

# Credentials and machine-specific configuration, including nested files.
.env
.env.*
!.env.example
*.pem
*.key
credentials.json
secrets.json
.aws/
.codex/
.agents/

# Environments, caches, test output, and editor files.
.venv/
venv/
__pycache__/
*.py[cod]
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/
.idea/
.vscode/
.DS_Store
*.swp
*.tmp

# Datasets, models, results, and unpublished manuscripts.
*.joblib
*.pkl
*.pickle
*.npz
*.npy
*.pt
*.pth
*.safetensors
*.gguf
*.faiss
*.jsonl
*.parquet
*.csv
*.log
*.hwp
*.hwpx
*.pdf
*.zip
*.tar
*.gz

# Explicit publication requested by the project owner on 2026-10-26.
!/paper/**/*.hwp
!/paper/**/*.pdf
!/paper/**/*.csv
!/docs/*.csv
!/data/models/*.json
!/data/models/sequential_answer_gain_multiseed/*.joblib
/data/benchmarks/multihop/**
!/data/benchmarks/multihop/**/
!/data/benchmarks/multihop/**/*.json
/data/benchmarks/multihop/**/chunks.json
/data/benchmarks/multihop/**/chunk_graph.json
/data/benchmarks/multihop/**/chunk_graph_meta.json
/data/benchmarks/multihop/**/index_manifest.json

# Release bundles are generated locally, not committed to Git.
/artifacts/
